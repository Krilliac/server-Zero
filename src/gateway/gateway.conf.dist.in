################################################################################
# Cluster gateway daemon configuration                                         #
################################################################################

[GatewayConf]
ConfVersion=@MANGOS_REALM_VER@

################################################################################
# GATEWAY SETTINGS
#
#    LoginDatabaseInfo
#    CharacterDatabaseInfo
#        Connection settings for the realm/authentication and character databases
#        Format: hostname;port;username;password;database
#                Use named pipes at Windows
#                .;somenumber;username;password;database
#                Use Unix sockets on Unix/Linux
#                .;/path/to/unix_socket;username;password;database
#
#    GatewayPort
#        Port on which the gateway accepts inbound client connections
#        Default: 8085
#
#    Node.Count
#        Number of backend mangosd nodes the gateway connects to. The gateway
#        opens one authenticated link per node (Node.1 .. Node.<Count>).
#        Default: 1
#
#    Node.N.Host
#    Node.N.IntakePort
#        Per-node connection info: the host + gateway-intake TCP port of backend
#        node N. IntakePort MUST match that node's mangosd.conf Gateway.IntakePort.
#        (The legacy Phase 1 key Node.N.GatewayPort is still accepted as an alias
#        for IntakePort, but new configs should use IntakePort.)
#        Example 2-node setup (two mangosd on loopback):
#            Node.Count          = 2
#            Node.1.Host         = 127.0.0.1
#            Node.1.IntakePort   = 9100
#            Node.2.Host         = 127.0.0.1
#            Node.2.IntakePort   = 9101
#        The pre-world node (where a freshly-authed client attaches) is the
#        lowest-numbered node that is currently connected.
#
#    Gateway.Secret
#        Pre-shared secret that authenticates the gateway -> node link. It MUST
#        be identical to Gateway.Secret in EACH fronted node's mangosd.conf. The
#        gateway sends it as the first frame (GW_HELLO) on every (re)connect; the
#        node validates it with a constant-time compare and drops the link on any
#        mismatch. FAIL-CLOSED: if a node is configured but this is empty, the
#        gateway refuses to connect (logs an error). Use a long random value.
#        Default: "" (node link disabled until set)
#
#    Gateway.IntakeBindIP
#        (Node-side setting; documented here for symmetry.) On each node this is
#        the address its intake binds to — 127.0.0.1 by default, so the gateway
#        must reach the node over loopback/localhost. Set it in the node's
#        mangosd.conf, not here. Keep the gateway on the same host as the node it
#        fronts unless you have changed the node's bind IP intentionally.
#
#    LogFile
#        Logfile name
#        Default: "Gateway.log"
#                 "" - empty name disable creating log file
#
#    PidFile
#        Gateway daemon PID file
#        Default: "" Do not create a PID file.
#
#    LogLevel
#        Server console level of logging
#        0 = Minimum; 1 = Error; 2 = Detail; 3 = Full/Debug
#        Default: 1
#
#    Gateway.SelfTestAcEvent
#        Diagnostic for the Phase 1 anti-cheat channel. When 1, the gateway sends
#        ONE benign GW_AC_EVENT (type = AC_VIOLATION_RATE, severity = 1,
#        "selftest") to the owning node right after each client's session opens,
#        so a full gateway -> node -> AntiCheatMgr round-trip can be observed in
#        the node log (the node records an AC_VIOLATION_RATE for that player).
#        Pure diagnostic; leave OFF in production.
#        Default: 0
#
#    Gateway.AntiCheat.Enable
#        Master switch for all Phase 2 gateway edge anti-cheat checks
#        (rate/flood, protocol/opcode, session integrity). Per-check switches
#        below let you disable parts. All defaults are tolerant of lag + legit
#        play; detection REPORTS to the owning node (which applies GM-exempt
#        scoring) and only disconnects on egregious flood / malformed packets.
#        Default: 1
#
#    Gateway.AntiCheat.Rate.Enable          (default 1)
#    Gateway.AntiCheat.Rate.Burst           per-opcode token-bucket capacity
#                                            (burst allowance). Default: 40
#    Gateway.AntiCheat.Rate.RefillPerSec    per-opcode tokens refilled / sec.
#                                            Default: 20
#    Gateway.AntiCheat.Rate.GlobalPerSec    total packets/sec/connection above
#                                            which a rate violation is reported.
#                                            Default: 300
#    Gateway.AntiCheat.Rate.FloodDisconnectPerSec
#                                            total packets/sec/connection above
#                                            which the connection is dropped at
#                                            the edge. Default: 2000
#
#    Gateway.AntiCheat.Protocol.Enable      (default 1)
#    Gateway.AntiCheat.Protocol.MaxPayloadBytes
#                                            per-packet payload cap; a larger
#                                            payload is dropped + reported. The
#                                            header layer already caps total size
#                                            at 10240. Default: 8192
#
#    Gateway.AntiCheat.Session.Enable       (default 1)
#    Gateway.AntiCheat.Session.OnePerAccount
#                                            report when a second live connection
#                                            opens for an account. Default: 1
#    Gateway.AntiCheat.Session.MaxAccountsPerIp
#                                            accounts-per-source-IP cap; exceeding
#                                            it is reported (multi-box limit).
#                                            0 = unlimited. Default: 8
#    Gateway.AntiCheat.Session.FlagIpChange report a mid-session source-IP change
#                                            (possible hijack). Default: 1
#
#    Gateway.AntiCheat.Severity.Rate / .Protocol / .Session
#        0..255 hints the node maps to a kick_score weight. Defaults 20/30/25.
#
#    Gateway.AntiSpeed.Enable
#        Phase 3 independent-clock speedhack detector. The gateway timestamps
#        each movement packet on arrival with a neutral monotonic clock and
#        compares the client's self-reported MovementInfo.time cadence against
#        real time over a sliding window. A sustained fast clock = speed/time
#        hack. It ONLY REPORTS (never disconnects); the node decides escalation.
#        0 makes it fully inert (no peeking, no per-connection state).
#        Default: 0
#    Gateway.AntiSpeed.Window           sliding-window ring size (samples). Default: 20
#    Gateway.AntiSpeed.MinSamples       min valid pairs before any evaluation. Default: 12
#    Gateway.AntiSpeed.TolerancePct     tripHigh = 1.0 + this/100; hysteresis
#                                        clears at half this over 1.0. Default: 30
#    Gateway.AntiSpeed.SustainWindows   consecutive hot full-window evals required
#                                        to fire (sustained, not a blip). Default: 3
#    Gateway.AntiSpeed.MaxGapMs         pair-discard threshold for idle/pause/huge
#                                        jump filtering. Default: 3000
#    Gateway.AntiSpeed.CooldownMs       min ms between reports per client after a
#                                        fire. Default: 10000
#
################################################################################
LoginDatabaseInfo      = "127.0.0.1;3306;root;mangos;realmd"
CharacterDatabaseInfo  = "127.0.0.1;3306;root;mangos;character0"

GatewayPort            = 8085

Node.Count             = 1

Node.1.Host            = 127.0.0.1
Node.1.IntakePort      = 9100

# Example second node (enable by raising Node.Count to 2):
# Node.2.Host           = 127.0.0.1
# Node.2.IntakePort     = 9101

Gateway.Secret         = ""

LogFile                = "Gateway.log"
PidFile                = ""
LogLevel               = 1

Gateway.SelfTestAcEvent = 0

# --- Phase 2 gateway edge anti-cheat (tolerant defaults) ---
Gateway.AntiCheat.Enable                     = 1
Gateway.AntiCheat.Rate.Enable                = 1
Gateway.AntiCheat.Rate.Burst                 = 40
Gateway.AntiCheat.Rate.RefillPerSec          = 20
Gateway.AntiCheat.Rate.GlobalPerSec          = 300
Gateway.AntiCheat.Rate.FloodDisconnectPerSec = 2000
Gateway.AntiCheat.Protocol.Enable            = 1
Gateway.AntiCheat.Protocol.MaxPayloadBytes   = 8192
Gateway.AntiCheat.Session.Enable             = 1
Gateway.AntiCheat.Session.OnePerAccount      = 1
Gateway.AntiCheat.Session.MaxAccountsPerIp   = 8
Gateway.AntiCheat.Session.FlagIpChange       = 1
Gateway.AntiCheat.Severity.Rate              = 20
Gateway.AntiCheat.Severity.Protocol          = 30
Gateway.AntiCheat.Severity.Session           = 25

# --- Phase 3 independent-clock speedhack detector (OFF by default; report-only) ---
Gateway.AntiSpeed.Enable                     = 0
Gateway.AntiSpeed.Window                     = 20
Gateway.AntiSpeed.MinSamples                 = 12
Gateway.AntiSpeed.TolerancePct               = 30
Gateway.AntiSpeed.SustainWindows             = 3
Gateway.AntiSpeed.MaxGapMs                   = 3000
Gateway.AntiSpeed.CooldownMs                 = 10000
